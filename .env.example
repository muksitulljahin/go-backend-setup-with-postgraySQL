# Server Configuration
PORT=8080
APP_ENV=development

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=postgres_db
DB_SSLMODE=disable
DB_TIMEZONE=UTC

# Swagger Basic Authentication Credentials
SWAGGER_USER=admin
SWAGGER_PASSWORD=admin123

# JWT Configuration
JWT_SECRET=super_secret_jwt_key_123
# 15 days 15 * 24 hour
JWT_EXPIRATION_HOURS=360


R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_access_key
R2_SECRET_ACCESS_KEY=your_secret_key
R2_BUCKET_NAME=nuts-and-kids-products
R2_PUBLIC_URL=https://your-image-domain.com


# CORS Configuration (comma-separated allowed frontend origins)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
